BasicInfo:
  Title                   : "Hollow Knight 3DS HD"
  ProductCode             : "CTR-H-HK3H"
  Logo                    : Homebrew

RomFs:
  RootPath                : romfs_hd

TitleInfo:
  Category                : Application
  UniqueId                : 0xF4C3E

Option:
  UseOnSD                 : true
  FreeProductCode         : true
  MediaFootPadding        : false
  EnableCrypt             : false
  EnableCompress          : true

AccessControlInfo:
  CoreVersion                   : 2
  DescVersion                   : 2
  ReleaseKernelMajor            : "02"
  ReleaseKernelMinor            : "33"
  UseExtSaveData                : false
  FileSystemAccess:
   - DirectSdmc
   - DirectSdmcWrite
  IoAccessControl:
  MemoryType                    : Application
  SystemMode                    : 64MB
  IdealProcessor                : 0
  AffinityMask                  : 1
  Priority                      : 16
  MaxCpu                        : 0
  HandleTableSize               : 0x200
  DisableDebug                  : false
  EnableForceDebug              : false
  CanWriteSharedPage            : true
  CanUsePrivilegedPriority      : false
  CanUseNonAlphabetAndNumber    : true
  PermitMainFunctionArgument    : true
  CanShareDeviceMemory          : true
  RunnableOnSleep               : false
  SpecialMemoryArrange          : true
  SystemModeExt                 : 124MB
  CpuSpeed                      : 804MHz
  EnableL2Cache                 : true
  CanAccessCore2                : true

  # Virtual address mappings (same as devkitPro's template). Without the DSP one, ndsp crashes on its first write
  # to DSP RAM when the game runs as an installed CIA (the Homebrew Launcher's host app already has it mapped).
  IORegisterMapping:
   - 1ff00000-1ff7ffff   # DSP memory
  MemoryMapping:
   - 1f000000-1f5fffff:r # VRAM
  SystemCallAccess:
    AcknowledgeHardwareInterrupt: 0x6F
    ArbitrateAddress: 0x22
    Backdoor: 0x3D
    BindInterrupt: 0x50
    Break: 0x3C
    CancelTimer: 0x1C
    ClearEvent: 0x19
    ClearTimer: 0x1D
    CloseHandle: 0x23
    ConnectToPort: 0x2D
    ControlMemory: 0x01
    ControlProcessMemory: 0x70
    CreateAddressArbiter: 0x21
    CreateEvent: 0x17
    CreateMemoryBlock: 0x1E
    CreateMutex: 0x13
    CreateSemaphore: 0x15
    CreateThread: 0x08
    CreateTimer: 0x1A
    DuplicateHandle: 0x27
    ExitProcess: 0x03
    ExitThread: 0x09
    FlushProcessDataCache: 0x54
    GetCurrentProcessorNumber: 0x11
    GetHandleInfo: 0x29
    GetProcessId: 0x35
    GetProcessIdOfThread: 0x36
    GetProcessIdealProcessor: 0x06
    GetProcessInfo: 0x2B
    GetResourceLimit: 0x38
    GetResourceLimitCurrentValues: 0x3A
    GetResourceLimitLimitValues: 0x39
    GetSystemInfo: 0x2A
    GetSystemTick: 0x28
    GetThreadContext: 0x3B
    GetThreadId: 0x37
    GetThreadIdealProcessor: 0x0F
    GetThreadInfo: 0x2C
    GetThreadPriority: 0x0B
    InvalidateProcessDataCache: 0x52
    MapMemoryBlock: 0x1F
    OutputDebugString: 0x3D
    QueryMemory: 0x02
    ReleaseMutex: 0x14
    ReleaseSemaphore: 0x16
    SendSyncRequest1: 0x2E
    SendSyncRequest2: 0x2F
    SendSyncRequest3: 0x30
    SendSyncRequest4: 0x31
    SendSyncRequest: 0x32
    SetThreadPriority: 0x0C
    SetTimer: 0x1B
    SignalEvent: 0x18
    SleepThread: 0x0A
    StoreProcessDataCache: 0x53
    UnmapMemoryBlock: 0x20
    WaitSynchronization1: 0x24
    WaitSynchronizationN: 0x25
  InterruptNumbers:
  ServiceAccessControl:
   - APT:U
   - $hioFIO
   - $hostio0
   - $hostio1
   - ac:u
   - boss:U
   - cam:u
   - cecd:u
   - cfg:u
   - dlp:FKCL
   - dlp:SRVR
   - dsp::DSP
   - frd:u
   - fs:USER
   - gsp::Gpu
   - hid:USER
   - http:C
   - ir:rst
   - ir:u
   - ir:USER
   - mic:u
   - ndm:u
   - news:u
   - nwm::UDS
   - ptm:u
   - pxi:dev
   - soc:U
   - ssl:C
   - y2r:u
   - ldr:ro
   - am:net
   - ps:ps
SystemControlInfo:
  SaveDataSize: 0KB
  RemasterVersion: 0
  StackSize: 0x40000
  Dependency:
    ac: 0x0004013000002402L
